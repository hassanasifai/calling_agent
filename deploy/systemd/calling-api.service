[Unit]
Description=Calling agent private inference API (ASR, TTS, LLM proxy)
Wants=calling-llm.service
After=calling-llm.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Slice=calling-ai.slice
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/config/local/vm-api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO__/.venv/bin/python -m nrsp_agent.inference_api --config config/local/vm-api.toml
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
