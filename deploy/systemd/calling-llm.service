[Unit]
Description=Calling agent LLM (llama.cpp, loopback 127.0.0.1:18431)
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Slice=calling-ai.slice
WorkingDirectory=__REPO__
Environment=LLM_THREADS=5 LLM_NICE=5
ExecStart=__REPO__/scripts/run_llm_server.sh
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
